{
  "name": "claims-engine-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:local:start && npm run db:deploy && npm run start:dev",
    "postinstall": "prisma generate",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "test": "npm run build && node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-start.ps1",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-stop.ps1"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^22.20.5",
    "prisma": "6.19.3",
    "typescript": "^5.9.3"
  }
}
